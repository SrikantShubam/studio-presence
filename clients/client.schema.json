        },
        "yearFounded": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "address": {
          "type": "object",
          "properties": {
            "line1": {
              "type": "string"
            },
            "locality": {
              "type": "string"
            },
            "city": {
              "type": "string"
