{
  "name": "studio-presence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run check:config && npm run gen:tenant-map && npm run build --workspace frontend",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "lint": "eslint . --max-warnings 0",
    "gen:schema": "node --env-file-if-exists=.env --import tsx scripts/gen-schema.ts",
    "check:config": "node --env-file-if-exists=.env --import tsx scripts/check-config.ts",
    "check:hardcode": "node --env-file-if-exists=.env --import tsx scripts/check-hardcode.ts",
    "check:placeholder": "node --env-file-if-exists=.env --import tsx scripts/check-placeholder.ts",
    "check:tiers": "node --env-file-if-exists=.env --import tsx scripts/check-tiers.ts",
    "check:tenant-isolation": "node --env-file-if-exists=.env --import tsx scripts/check-tenant-isolation.ts",
    "check:all": "npm run typecheck && npm run lint && npm run check:config && npm run check:tiers && npm run check:tenant-isolation && npm run check:hardcode && npm run check:placeholder",
    "test:rls": "node --env-file-if-exists=.env --import tsx scripts/test-rls.ts",
    "gen:tenant-map": "node --env-file-if-exists=.env --import tsx scripts/gen-tenant-map.ts",
    "sync:env": "node --import tsx scripts/sync-frontend-env.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  }
}
