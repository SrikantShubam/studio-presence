{
  "name": "studio-presence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "test:demo-lifecycle": "node --env-file-if-exists=.env --import tsx scripts/test-demo-lifecycle.ts",
    "test:platform-auth": "node --env-file-if-exists=.env --import tsx scripts/test-platform-auth.ts",
    "test:onboarding": "node --env-file-if-exists=.env --import tsx scripts/test-onboarding.ts",
    "test:middleware": "node --env-file-if-exists=.env --import tsx scripts/test-middleware.ts",
    "test:preview-host": "node --import tsx scripts/test-preview-host.ts",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run check:deploy-source && npm run check:config && npm run gen:tenant-map && npm run build --workspace frontend",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "lint": "eslint . --max-warnings 0",
    "gen:schema": "node --env-file-if-exists=.env --import tsx scripts/gen-schema.ts",
    "check:config": "node --env-file-if-exists=.env --import tsx scripts/check-config.ts",
    "check:hardcode": "node --env-file-if-exists=.env --import tsx scripts/check-hardcode.ts",
    "check:public-content": "node --env-file-if-exists=.env --import tsx scripts/check-public-hardcoded-content.ts",
    "check:placeholder": "node --env-file-if-exists=.env --import tsx scripts/check-placeholder.ts",
    "check:legacy-artifacts": "node --env-file-if-exists=.env --import tsx scripts/check-legacy-artifacts.ts",
    "check:tiers": "node --env-file-if-exists=.env --import tsx scripts/check-tiers.ts",
    "check:tenant-isolation": "node --env-file-if-exists=.env --import tsx scripts/check-tenant-isolation.ts",
    "check:deploy-source": "node --env-file-if-exists=.env --import tsx scripts/check-deploy-source.ts",
    "check:all": "npm run typecheck && npm run lint && npm run check:config && npm run check:tiers && npm run check:tenant-isolation && npm run check:hardcode && npm run check:public-content && npm run check:placeholder && npm run check:legacy-artifacts",
    "test:rls": "node --env-file-if-exists=.env --import tsx scripts/test-rls.ts",
    "test:analytics": "node --env-file-if-exists=.env --import tsx scripts/test-analytics.ts",
    "test:panel": "node --env-file-if-exists=.env --import tsx scripts/test-panel.ts",
    "test:admin-redesign": "node --env-file-if-exists=.env --import tsx scripts/test-admin-redesign.ts",
    "gen:tenant-map": "node --env-file-if-exists=.env --import tsx scripts/gen-tenant-map.ts",
    "sync:env": "node --import tsx scripts/sync-frontend-env.ts",
    "images:variants": "node scripts/generate-image-variants.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  }
}
